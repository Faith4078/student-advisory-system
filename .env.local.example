# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database
# Optional: use a pooled runtime URL when your provider supplies one.
# DATABASE_URL_POOLED=postgresql://user:password@pooler-host:5432/database

#AI Advisor memory (mem0.ai platform API key — get one at https://app.mem0.ai/dashboard/api-keys)
#Leave unset to run with memory features disabled (the app still works without it).
MEM0_API_KEY=

#Project discovery/advisor architecture (document ingestion, embeddings, hybrid
#retrieval, LangGraph agent, security, caching). Paste real keys below; each
#service degrades or stays unimplemented until its key is present.
GEMINI_API_KEY=
JINA_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ARCJET_KEY=

#Cloudflare R2 (S3-compatible) — where uploaded source PDFs are stored. Keep
#the bucket private; the app uses presigned URLs, never a public bucket URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=